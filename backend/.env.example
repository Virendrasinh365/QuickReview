# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eazyreview?retryWrites=true&w=majority

# Backend Server Port
PORT=5000

# Groq Cloud API Key (for LLM review generation)
GROQ_API_KEY=gsk_your_groq_api_key_here

# JWT Secret Key for Admin Authentication
JWT_SECRET=eazyreview_jwt_secret_key_change_in_production
