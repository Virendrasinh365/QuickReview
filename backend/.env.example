# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickreview?retryWrites=true&w=majority

# Backend Server Port
PORT=5000

# Groq Cloud API Key (for LLM review generation)
GROQ_API_KEY=gsk_your_groq_api_key_here

# REQUIRED. Long random string (>=16 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Allowed browser origin(s) for CORS, comma-separated (your deployed frontend URL)
FRONTEND_URL=http://localhost:5173

# Optional: creates the first admin ONLY when the users collection is empty.
# Remove these after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: invite code needed to register additional admins.
# Leave empty to disable registration completely.
REGISTRATION_CODE=
